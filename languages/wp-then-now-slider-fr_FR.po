msgstr "Oui"

#, php-format
msgid "Global colors can be changed in %s."
msgstr "Les couleurs globales se modifient dans %s."

msgid "Before / After > Settings"
msgstr "Avant / Après > Réglages"

msgid "Tip: use two images with the same dimensions for perfect alignment."
msgstr "Astuce : utilisez deux images de mêmes dimensions pour un alignement parfait."

msgid "Save the comparison to get its shortcode."
msgstr "Enregistrez la comparaison pour obtenir son shortcode."

msgid "Copy"
msgstr "Copier"

msgid "Paste this shortcode into a page or post, or use the “Before / After” block."
msgstr "Collez ce shortcode dans une page ou un article, ou utilisez le bloc « Avant / Après »."

msgid "Choose both images, then save to see the preview."
msgstr "Choisissez les deux images puis enregistrez pour voir l’aperçu."

msgid "Use this image"
msgstr "Utiliser cette image"

msgid "Copied!"
msgstr "Copié !"

msgid "Before / After settings"
msgstr "Réglages Avant / Après"

msgid "Settings"
msgstr "Réglages"

msgid "These colors apply to every comparison set to “Global colors”."
msgstr "Ces couleurs s’appliquent à toutes les comparaisons réglées sur « Couleurs globales »."

msgid "Handle color when selected or being dragged. Leave empty to use the theme color."
msgstr "Couleur de la poignée sélectionnée ou en cours de glissement. Laissez vide pour utiliser la couleur du thème."

msgid "Comparisons"
msgstr "Comparaisons"

msgid "Create and manage multiple before / after photo comparisons with a draggable slider. Includes the [then_now id=\"X\"] shortcode and a Gutenberg block."
msgstr "Créez et gérez plusieurs comparaisons de photos avant / après avec un curseur glissant. Shortcode [then_now id=\"X\"] et bloc Gutenberg inclus."

msgid "Check for updates"
msgstr "Vérifier les mises à jour"

#, php-format
msgid "WP Then Now Slider: version %s is available. Use the “Update now” link below."
msgstr "WP Then Now Slider : la version %s est disponible. Utilisez le lien « Mettre à jour » ci-dessous."

#, php-format
msgid "WP Then Now Slider: you are using the latest version (%s)."
msgstr "WP Then Now Slider : vous utilisez la dernière version (%s)."

msgid "WP Then Now Slider: unable to reach GitHub right now. Please try again later."
msgstr "WP Then Now Slider : impossible de joindre GitHub pour le moment. Réessayez plus tard."

